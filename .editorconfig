# Keeps formatting consistent across editors so a contributor's IDE defaults do not
# produce whitespace-only diffs.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.md]
# Markdown uses trailing double-space for hard line breaks.
trim_trailing_whitespace = false

[*.py]
indent_size = 4
max_line_length = 100

[{*.yml,*.yaml}]
indent_size = 2

[*.ipynb]
insert_final_newline = false
