{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KrishiBid Express + MongoDB API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/scripts/seed.ts",
    "ingest:kb": "tsx src/scripts/ingestKb.ts",
    "create:indexes": "tsx src/scripts/createIndexes.ts",
    "migrate:emails": "tsx src/scripts/migrateEmails.ts",
    "migrate:marketplace": "tsx src/scripts/migrateMarketplace.ts",
    "migrate:marketplace:prod": "node dist/migrateMarketplace.js",
    "mail:test": "tsx src/scripts/sendTestEmail.ts",
    "mail:test:prod": "node dist/sendTestEmail.js",
    "migrate:emails:prod": "node dist/migrateEmails.js",
    "seed:prod": "node dist/seed.js",
    "ingest:kb:prod": "node dist/ingestKb.js",
    "create:indexes:prod": "node dist/createIndexes.js",
    "eval:rag": "tsx src/scripts/evalRag.ts",
    "eval:rag:prod": "node dist/evalRag.js"
  },
  "dependencies": {
    "@krishibid/shared": "*",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "onnxruntime-node": "^1.20.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "mongodb-memory-server": "^10.1.2",
    "supertest": "^7.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
