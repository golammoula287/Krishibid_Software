# =============================================================================
# KrishiBid — environment template
#
#   cp .env.example .env    then fill in the blanks
#
# .env is gitignored and must never be committed.
# =============================================================================

# ---- runtime ----
NODE_ENV=development
PORT=5000
# Public base URL of the API. MUST be public HTTPS in production — SSLCOMMERZ posts
# the IPN callback server-to-server, so localhost never receives it. Use a tunnel
# (cloudflared / ngrok) during development.
API_PUBLIC_URL=http://localhost:5000
WEB_PUBLIC_URL=http://localhost:5173
# Comma-separated CORS allowlist.
CORS_ORIGINS=http://localhost:5173

# ---- database (MongoDB Atlas M0 free tier) ----
# mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/krishibid?retryWrites=true&w=majority
MONGODB_URI=

# ---- auth ----
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# ---- AI provider ----
# Which provider the AI layer resolves to: gemini | claude | groq
AI_PROVIDER=gemini

# Gemini — free tier, the default. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Claude — paid, no free tier. Only needed when AI_PROVIDER=claude.
# NOTE: Anthropic has no embeddings endpoint, so GEMINI_API_KEY is still required
# for retrieval even on the Claude path.
ANTHROPIC_API_KEY=
CLAUDE_CHAT_MODEL=claude-opus-5

# Groq — free tier, generation only (no embeddings endpoint, so GEMINI_API_KEY is
# still required for retrieval). Key: https://console.groq.com/keys
# Very fast inference and a quota separate from Gemini's, but its open models handle
# Bengali less well, which is why Gemini remains the default.
# Verify the model is still offered: https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Embedding dimensions. MUST match the Atlas Vector Search index definition.
# Changing this requires re-ingesting the KB and rebuilding the index.
EMBEDDING_DIMENSIONS=1536

# ---- image storage (Cloudinary free tier) ----
# Optional in development: without it, images are stored inline as data URLs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- payments: SSLCOMMERZ ----
# Sandbox credentials: https://developer.sslcommerz.com/registration/
# Sandbox store IDs usually end in "_testbox"; the sandbox is free to test against.
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
# false = sandbox endpoints, true = securepay live endpoints
SSLCZ_IS_LIVE=false

# Platform commission taken from the farmer's payout at release, in basis points.
# 250 = 2.50%.
PLATFORM_COMMISSION_BPS=250

# Escrow auto-release: if the buyer never confirms delivery, funds release to the
# farmer this many days after the order enters in_transit. Without this an
# inattentive buyer strands the farmer's money indefinitely.
ESCROW_AUTO_RELEASE_DAYS=7

# Buyer must pay within this window after a bid is accepted, or the order is
# cancelled and the lot is relisted.
PAYMENT_WINDOW_HOURS=48

# ---- ML inference ----
# Paths are resolved relative to the server working directory.
DISEASE_MODEL_PATH=../ml/artifacts/model-v1.onnx
DISEASE_LABELS_PATH=../ml/artifacts/labels.json
# Predictions below this confidence are reported as "uncertain" rather than shown
# as a diagnosis.
DISEASE_CONFIDENCE_THRESHOLD=0.60

# ---- RAG tuning ----
RAG_VECTOR_INDEX=kb_vector_index
RAG_TEXT_INDEX=kb_text_index
RAG_NUM_CANDIDATES=150
RAG_RETRIEVE_LIMIT=20
RAG_CONTEXT_LIMIT=4
RAG_RRF_K=60
RAG_CACHE_TTL_HOURS=24
RAG_ENABLE_RERANK=true

# ---- rate limits ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_INFERENCE_MAX=10
RATE_LIMIT_CHAT_PER_HOUR=20

# ---- demo mode ----
# Enables the one-click seeded demo logins. Keep true for a public demo.
DEMO_MODE=true
DEMO_PASSWORD=
